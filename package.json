{
  "name": "psqlex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small local Postgres query runner and explainer with a web UI and an MCP server",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/cli.ts serve\" \"vite\"",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "pnpm build && node dist/psqlex.mjs serve",
    "mcp": "tsx src/server/cli.ts mcp",
    "package": "pnpm build && sh scripts/package.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "pg-cursor": "^2.22.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "bin": {
    "psqlex": "bin/psqlex"
  },
  "engines": {
    "node": ">=20.11"
  }
}
